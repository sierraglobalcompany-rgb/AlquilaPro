{
  "name": "sierraglobalcompany/alquila-pro",
  "description": "Alquila Pro - administración simple de arrendamientos y parqueaderos",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3 <8.6",
    "dompdf/dompdf": "^3.1.6",
    "phpmailer/phpmailer": "^7.1",
    "slim/psr7": "^1",
    "slim/slim": "^4",
    "smalot/pdfparser": "^2.13.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "AlquilaPro\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AlquilaPro\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
